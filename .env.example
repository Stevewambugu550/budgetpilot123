# Copy this file to `.env.local` and fill in your real values.
# Never commit .env.local to version control.

# Neon Postgres connection string (server-side only)
DATABASE_URL=postgres://user:password@host/dbname

# Google OAuth credentials (server-side only)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# Google Client ID exposed to the frontend for the sign-in button
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Gemini API key — powers the built-in AI chat assistant (Pilot AI)
# Get yours free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
